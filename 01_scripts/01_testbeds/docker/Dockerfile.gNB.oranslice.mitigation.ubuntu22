# ORANSlice TM — gNB runtime image (RFsimulator only, no USRP/UHD)
FROM ran-build-mitigation:latest AS gnb-build

FROM ubuntu:jammy AS oai-gnb
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash procps net-tools iproute2 iputils-ping \
        libsctp1 libjson-c5 libconfig9 libprotobuf-c1 libblas3 openssl \
        libboost-chrono1.74.0 libboost-date-time1.74.0 libboost-filesystem1.74.0 \
        libboost-regex1.74.0 libboost-serialization1.74.0 libboost-thread1.74.0 \
        libboost-system1.74.0 libboost-program-options1.74.0 \
        ca-certificates && \
    apt-get clean -y && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/oai-gnb/bin
COPY --from=gnb-build /oai-ran/cmake_targets/ran_build/build/nr-softmodem ./

COPY --from=gnb-build \
    /oai-ran/cmake_targets/ran_build/build/librfsimulator.so \
    /oai-ran/cmake_targets/ran_build/build/libcoding.so \
    /oai-ran/cmake_targets/ran_build/build/libparams_libconfig.so \
    /oai-ran/cmake_targets/ran_build/build/libdfts.so \
    /usr/local/lib/

COPY --from=gnb-build /oai-ran/cmake_targets/ran_build/build/libldpc*.so /usr/local/lib/

RUN ln -sf /usr/local/lib/librfsimulator.so /usr/local/lib/liboai_device.so && \
    ldconfig && \
    ldd /opt/oai-gnb/bin/nr-softmodem

WORKDIR /opt/oai-gnb
CMD ["/opt/oai-gnb/bin/nr-softmodem"]
