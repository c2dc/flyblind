+  UE_iterator(UE_list, UE) {
+    NR_UE_sched_ctrl_t *sched_ctrl = &UE->UE_sched_ctrl;
+    if (UE->Msg4_ACKed != true || sched_ctrl->ul_failure)
+      continue;
+    const int sid = tm_ul_ue_sid(sched_ctrl);
+    if (sid <= 0)
+      continue;
+    const int B = max(0, sched_ctrl->estimated_ul_buffer - sched_ctrl->sched_ul_bytes);
+    for (int k = 0; k < nslices; k++) {
+      if (slices[k].sid == sid) {
+        slices[k].demand_bytes += (uint32_t)B;
+        if (B > 0)
+          slices[k].active = 1;
+        break;
+      }
+    }
+  }
+
+  /* Thin-first slice ordering, like the DL qsort(compare_s) on prb_est. */
+  qsort(slices, nslices, sizeof(tm_ul_slice_t), tm_ul_slice_cmp);
+
+  /* Stage 2: default slice first (SRB-only UEs, e.g. during attach), no cap
+   * beyond the shared pool; then data slices thin-first under their budgets. */
+  tm_pf_ul_slice_newtx(module_id, frame, slot, UE_list, 0, n_rb_sched_init, &remainUEs, &n_rb_sched, rballoc_mask);
+
+  /* Per-slice budgets, computed at each slice's turn exactly like
+   * dl_sched_unit: slices already served reserve their ACTUAL usage
+   * (work-conserving, mirrors "SL_sched->min_prbs = n_rb_sched_s" in
+   * pf_dl_slice), slices not yet served reserve their configured band.
+   * 3GPP TS 28.541 tri-partition on top of the DL formula:
+   *   - dedicated_j is never lendable (reserved even when slice j is idle or
+   *     under-used);
+   *   - the prioritized band (min_j - dedicated_j) is reserved only while
+   *     slice j has BSR demand; when idle it is lent (Prioritized semantics);
+   *   - the result is clamped to cell * max_ratio_i (Shared upper bound).
+   * With every slice active this reduces exactly to the DL computation
+   * max_i = cell - sum_j(min_j), preserving each slice's min guarantee. */
+  for (int i = 0; i < nslices; i++) {
+    int reserved_by_others = 0;
+    for (int j = 0; j < nslices; j++) {
+      if (j == i)
+        continue;
+      if (slices[j].scheduled) {
+        /* Actual grants of already-served slices; dedicated stays reserved. */
+        reserved_by_others += slices[j].used_prbs > slices[j].dedi_prbs ? slices[j].used_prbs : slices[j].dedi_prbs;
+      } else {
+        int prioritized = slices[j].min_prbs - slices[j].dedi_prbs;
+        if (prioritized < 0)
+          prioritized = 0;
+        reserved_by_others += slices[j].dedi_prbs + (slices[j].active ? prioritized : 0);
+      }
+    }
+    int m = n_rb_sched_init - reserved_by_others;
+    const int cap = (n_rb_sched_init * slices[i].max_ratio) / 100;
+    if (m > cap)
+      m = cap;
+    if (m < 0)
+      m = 0;
+    slices[i].max_prbs = m;
+
+    slices[i].used_prbs = tm_pf_ul_slice_newtx(module_id, frame, slot, UE_list, slices[i].sid, slices[i].max_prbs, &remainUEs, &n_rb_sched, rballoc_mask);
+    slices[i].scheduled = 1;
+  }
+
+  if ((frame & 127) == 0 && slot == 0) {
+    for (int i = 0; i < nslices; i++)
+      LOG_I(NR_MAC, "[TM_UL_RRMPOLICY] %4d.%2d sid %d active %d demand %u B dedi %d min %d max %d used %d PRB (cell %d)\n",
+            frame, slot, slices[i].sid, slices[i].active, slices[i].demand_bytes,
+            slices[i].dedi_prbs, slices[i].min_prbs, slices[i].max_prbs, slices[i].used_prbs, n_rb_sched_init);
+  }
+}
