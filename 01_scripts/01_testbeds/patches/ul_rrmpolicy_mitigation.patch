+                                int n_rb_sched,
+                                uint16_t *rballoc_mask)
+{
+  gNB_MAC_INST *nrmac = RC.nrmac[module_id];
+  NR_Slices_t *SL_info = &nrmac->SL_info;
+  int remainUEs = max_num_ue;
+  const int n_rb_sched_init = n_rb_sched;
