+  /* Stage 1: HARQ retransmissions, all UEs, outside slice quotas. */
+  tm_ul_retx_stage(module_id, frame, slot, UE_list, &remainUEs, &n_rb_sched, rballoc_mask);
+
+  /* Build the per-slice budget table from the same rrmPolicy the DL uses. */
+  tm_ul_slice_t slices[MAX_NUM_SLICE + 1];
+  int nslices = 0;
+  SL_iterator(SL_info->list, SL) {
+    if (SL->sid <= 0)
+      continue;
+    tm_ul_slice_t *e = &slices[nslices++];
+    e->sid = SL->sid;
+    e->max_ratio = SL->spolicy.max_ratio;
+    e->active = 0;
+    e->demand_bytes = 0;
+    e->dedi_prbs = (n_rb_sched_init * SL->spolicy.dedicated_ratio) / 100;
+    e->min_prbs = (n_rb_sched_init * SL->spolicy.min_ratio) / 100;
+    e->max_prbs = n_rb_sched_init;
+    e->used_prbs = 0;
+    e->scheduled = 0;
+  }
+
